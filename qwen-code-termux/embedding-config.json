{
  "version": "1.0",
  "description": "Embedding config untuk RAG/indexing codebase (di luar Qwen Code CLI)",
  "default_profile": "nvidia",
  "profiles": {
    "nvidia": {
      "model": "nvidia/nv-embedqa-e5-v5",
      "endpoint": "https://integrate.api.nvidia.com/v1/embeddings",
      "envKey": "NVIDIA_API_KEY",
      "dimensions": 1024,
      "max_input_tokens": 512,
      "request_body": {
        "input_type": "query",
        "truncate": "END"
      },
      "verified": true
    },
    "dashscope": {
      "model": "text-embedding-v3",
      "endpoint": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1/embeddings",
      "envKey": "DASHSCOPE_API_KEY",
      "dimensions": 1024,
      "request_body": {
        "encoding_format": "float"
      },
      "verified": "untested"
    }
  },
  "indexing": {
    "chunk_size": 512,
    "chunk_overlap": 64,
    "batch_size": 16,
    "storage_dir": "~/.opsora/qwen-code/embeddings"
  }
}
