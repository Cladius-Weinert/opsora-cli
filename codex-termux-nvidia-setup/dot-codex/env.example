# ~/.codex/.env.example — copy to ~/.codex/.env and fill in
# NEVER commit real keys. Loaded by termux-install.sh / ~/.bashrc

# ── Path A (recommended on phone): OpenRouter ───────────────────
# Create at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# BYOK: add the same NVIDIA key in OpenRouter dashboard
# https://openrouter.ai/settings/integrations  → NVIDIA
# OpenRouter then routes NVIDIA-hosted models through YOUR key (lower markup).

# ── NVIDIA (build.nvidia.com / integrate.api.nvidia.com) ────────
# Create at: https://build.nvidia.com/settings/api-keys
# Also used by smoke-test.sh nvidia and by LiteLLM on the VPS.
NVIDIA_API_KEY=nvapi-REPLACE_ME

# ── Path B: LiteLLM remote proxy ────────────────────────────────
# Must match general_settings.master_key / LITELLM_MASTER_KEY on the VPS
LITELLM_API_KEY=sk-litellm-REPLACE_ME
# Edit ~/.codex/config.toml [model_providers.litellm_proxy].base_url to match,
# or: codex -c 'model_providers.litellm_proxy.base_url="https://VPS:4000/v1"'
LITELLM_BASE_URL=https://YOUR_VPS_HOST:4000/v1

# ── Optional cloud keys (Path B LiteLLM backends) ───────────────
GROQ_API_KEY=gsk_REPLACE_ME
TOGETHER_API_KEY=REPLACE_ME
# LiteLLM also accepts TOGETHERAI_API_KEY
TOGETHERAI_API_KEY=REPLACE_ME
DEEPSEEK_API_KEY=sk-REPLACE_ME
# Google AI Studio / Gemini
GEMINI_API_KEY=REPLACE_ME
# Anthropic
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# ── Smoke / tooling ─────────────────────────────────────────────
# SMOKE_MODEL_OPENROUTER=qwen/qwen3-coder
# SMOKE_MODEL_LITELLM=nvidia-qwen3-coder
# SMOKE_MODEL_NVIDIA=qwen/qwen3-coder-480b-a35b-instruct
