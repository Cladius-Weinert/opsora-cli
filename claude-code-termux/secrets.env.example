# Salin ke ~/.opsora/claude-code/secrets.env lalu isi API key Anda.
# JANGAN commit file ini dengan key asli.

# NVIDIA Integrate (wajib untuk model opsora-*)
# Dapatkan di: https://org.ngc.nvidia.com/setup/api-keys
export NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxx

# Proxy auth (harus sama dengan ANTHROPIC_AUTH_TOKEN di settings.json)
export LITELLM_MASTER_KEY=sk-opsora-local

# Alibaba DashScope (opsional — untuk opsora-qwen-*)
# export DASHSCOPE_API_KEY=sk-xxxxxxxx

# Model default saat gateway start (fast = recommended for Termux)
export OPSORA_DEFAULT_MODEL=opsora-fast
export OPSORA_FAST_MODEL=opsora-mini
