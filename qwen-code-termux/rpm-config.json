{
  "version": "1.0",
  "description": "RPM/concurrency tuning — Qwen Code tidak punya client RPM cap; gunakan retry + tier limits ini",
  "tiers": {
    "fast": {
      "maxParallel": 8,
      "maxRetries": 3,
      "retryInitialDelayMs": 1000,
      "retryMaxDelayMs": 30000,
      "timeoutMs": 60000,
      "notes": "Sub-agent, explore, background tasks"
    },
    "balanced": {
      "maxParallel": 4,
      "maxRetries": 5,
      "retryInitialDelayMs": 2000,
      "retryMaxDelayMs": 90000,
      "timeoutMs": 180000,
      "notes": "Coding sehari-hari, default agent"
    },
    "deep": {
      "maxParallel": 2,
      "maxRetries": 5,
      "retryInitialDelayMs": 3000,
      "retryMaxDelayMs": 120000,
      "timeoutMs": 300000,
      "notes": "Reasoning, arsitektur, model besar"
    }
  },
  "provider_limits": {
    "nvidia-integrate": {
      "estimated_rpm": 40,
      "burst_strategy": "retry_with_backoff",
      "error_codes": [503, 429],
      "error_pattern": "ResourceExhausted",
      "fallback_profile": "fast"
    },
    "dashscope-intl": {
      "estimated_rpm": 60,
      "burst_strategy": "enable_cache_control",
      "error_codes": [429],
      "fallback_profile": "nvidia-fast"
    },
    "coding-intl": {
      "estimated_rpm": 30,
      "burst_strategy": "weekly_quota",
      "fallback_profile": "power"
    }
  },
  "subagent": {
    "maxSubagentDepth": 3,
    "exploreModel": "fast",
    "backgroundModel": "fast",
    "reasoningModel": "reasoning"
  },
  "fallbacks": {
    "modelFallbacks": "qwen3-coder-flash,deepseek-ai/deepseek-v4-flash,meta/llama-3.1-8b-instruct",
    "on_503": "switch_to_fast_then_retry",
    "on_429": "exponential_backoff_then_fallback"
  }
}
