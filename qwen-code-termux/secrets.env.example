# Salin ke ~/.opsora/qwen-code/secrets.env lalu isi API key Anda.
# JANGAN commit file ini dengan key asli.

# ── NVIDIA Integrate (wajib untuk model nvidia-* dan embedding) ──
# Dapatkan di: https://org.ngc.nvidia.com/setup/api-keys
export NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxx

# ── DashScope International (wajib untuk model qwen3-*) ──
# Dapatkan di: https://bailian.console.alibabacloud.com/
export DASHSCOPE_API_KEY=sk-xxxxxxxx

# ── Alibaba Coding Plan (opsional — key TERPISAH dari DASHSCOPE) ──
# Dapatkan di: https://bailian.console.alibabacloud.com/ → Coding Plan
# export BAILIAN_CODING_PLAN_API_KEY=sk-sp-xxxxxxxx

# ── Model default saat start ──
export OPSORA_QWEN_DEFAULT_PROFILE=power
export OPSORA_QWEN_FAST_PROFILE=fast

# ── RPM / headless tuning ──
export QWEN_CODE_UNATTENDED_RETRY=1
export QWEN_CODE_API_TIMEOUT_MS=300000
export QWEN_CODE_MAX_OUTPUT_TOKENS=16384

# ── Direktori kerja (hindari /sdcard) ──
export QWEN_PROJECTS_DIR=$HOME/projects
