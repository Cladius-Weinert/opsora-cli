# litellm.env.example — copy to .env next to litellm-docker-compose.yml on the VPS
LITELLM_MASTER_KEY=sk-litellm-change-me-to-a-long-random-string

# Required for NVIDIA NIM backends
NVIDIA_API_KEY=nvapi-REPLACE_ME

# Optional multi-cloud
GROQ_API_KEY=gsk_REPLACE_ME
TOGETHER_API_KEY=REPLACE_ME
TOGETHERAI_API_KEY=REPLACE_ME
DEEPSEEK_API_KEY=sk-REPLACE_ME
GEMINI_API_KEY=REPLACE_ME
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
