{
  "security": {
    "auth": {
      "selectedType": "openai"
    }
  },
  "model": {
    "name": "qwen3-coder-plus",
    "baseUrl": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
    "reasoningEffort": "high",
    "maxSubagentDepth": 3,
    "sessionTokenLimit": -1
  },
  "fastModel": "openai:qwen3-coder-flash",
  "modelFallbacks": "qwen3-coder-flash,deepseek-ai/deepseek-v4-flash,meta/llama-3.1-8b-instruct",
  "agents": {
    "builtin": {
      "exploreModel": "fast"
    }
  },
  "ui": {
    "enableCacheSharing": true
  },
  "context": {
    "autoCompactThreshold": 0.85
  },
  "modelProviders": {
    "openai": {
      "protocol": "openai",
      "models": [
        {
          "id": "qwen3-coder-plus",
          "name": "Qwen3 Coder Plus (default)",
          "description": "Full power coding — 1M context, DashScope intl",
          "envKey": "DASHSCOPE_API_KEY",
          "baseUrl": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
          "generationConfig": {
            "timeout": 300000,
            "maxRetries": 5,
            "retryInitialDelayMs": 2000,
            "retryMaxDelayMs": 120000,
            "enableCacheControl": true,
            "contextWindowSize": 1000000,
            "splitToolMedia": true,
            "toolResultContentFormat": "parts",
            "samplingParams": {
              "temperature": 0.2,
              "top_p": 0.9,
              "max_tokens": 16384
            }
          }
        },
        {
          "id": "qwen3-coder-next",
