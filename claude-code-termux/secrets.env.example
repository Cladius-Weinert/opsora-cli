# Salin ke ~/.opsora/claude-code/secrets.env lalu isi API key Anda.
# JANGAN commit file ini dengan key asli.

# NVIDIA Integrate (wajib untuk model opsora-*)
# Dapatkan di: https://org.ngc.nvidia.com/setup/api-keys
export NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxx

# LiteLLM gateway auth (harus sama dengan ANTHROPIC_AUTH_TOKEN di settings.json)
export LITELLM_MASTER_KEY=sk-opsora-local

# Alibaba DashScope (opsional — fallback saat NVIDIA rate limit)
# export DASHSCOPE_API_KEY=sk-xxxxxxxx

# Opsora agent stack (memory, cache, context, skills)
export OPSORA_WORKSPACE_ROOT="$HOME"
export OPSORA_DIR="$HOME/.opsora"
export OPSORA_MAX_CONTEXT_TOKENS=24000
export OPSORA_KEEP_RECENT_MESSAGES=8
export OPSORA_SKILLS_DIRS="$HOME/.opsora/skills"

# Model default saat gateway start
export OPSORA_DEFAULT_MODEL=opsora-balanced
export OPSORA_FAST_MODEL=opsora-fast
